Subject: [PATCH] Handle reentrant and stale Wasm native events

Related upstream changes:
https://github.com/qt/qtbase/commit/3a217d2592602fb4bdef28d721871a161ecfb16f
https://github.com/qt/qtbase/commit/f410898d95218adc522bc6dac7cc4649fea52aab

A nested event loop may drain the shared pending-event queue. Check its
remaining length before shifting another event. Unlike the upstream change,
keep the initial batch bound. Skip queued events whose handler was removed,
and report how many events were consumed.

diff --git a/src/corelib/platform/wasm/qwasmsuspendresumecontrol.cpp b/src/corelib/platform/wasm/qwasmsuspendresumecontrol.cpp
--- a/src/corelib/platform/wasm/qwasmsuspendresumecontrol.cpp
+++ b/src/corelib/platform/wasm/qwasmsuspendresumecontrol.cpp
@@ -167,14 +167,17 @@
     int count = pendingEvents["length"].as<int>();
     if (count == 0)
         return false;
-    while (count-- > 0) {
+    int sent = 0;
+    // A handler can enter a nested event loop and drain the shared queue.
+    while (count-- > 0 && pendingEvents["length"].as<int>() > 0) {
         // Grab one event (handler and arg), and call it
         emscripten::val event = pendingEvents.call<val>("shift");
         auto it = m_eventHandlers.find(event["index"].as<int>());
-        Q_ASSERT(it != m_eventHandlers.end());
-        it->second(event["arg"]);
+        if (it != m_eventHandlers.end())
+            it->second(event["arg"]);
+        ++sent;
     }
-    return count;
+    return sent;
 }
 
 void qtSendPendingEvents()
